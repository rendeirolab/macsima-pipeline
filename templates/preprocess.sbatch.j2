#!/bin/bash
#SBATCH --partition={{ slurm.partition }}
#SBATCH --qos={{ slurm.qos }}
#SBATCH --job-name=preprocess_{{ experiment }}
#SBATCH --output={{ log_path }}
#SBATCH --cpus-per-task={{ slurm.cpus }}
#SBATCH --mem={{ slurm.mem }}
#SBATCH --time={{ slurm.time }}
{% if slurm.gres %}#SBATCH --gres={{ slurm.gres }}
{% endif %}
{% if slurm.comment %}#SBATCH --comment={{ slurm.comment }}
{% endif %}
{% if account %}#SBATCH --account={{ account }}
{% endif %}

set -euo pipefail

{% if stage_in_dir %}
# Second-layer cleanup: remove any stage-in copies this job left behind, even on a hard
# crash (the Python worker removes them on the normal path). Job-scoped so it is unambiguous.
trap 'rm -rf {{ stage_in_dir }}/macsima.$SLURM_JOB_ID.* 2>/dev/null || true' EXIT
{% endif %}
{{ body_cmd }}
